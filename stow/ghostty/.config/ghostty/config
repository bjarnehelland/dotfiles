unfocused-split-opacity = 0.5

# Neovim's colorscheme clears its own background, so this is what shows through.
# Blur keeps code legible over whatever is behind the window. Leaving
# background-opacity-cells at its default (false) means only the default
# background goes transparent — statusline blocks, Pmenu and Visual stay solid.
background-opacity = 0.85
background-blur = true

# Herdr is the multiplexer, so its splits, tabs, zoom and popups should answer
# to the Cmd chords macOS apps use — but Ghostty claims those first. Unbinding
# them here lets the key reach Herdr (it enables the kitty keyboard protocol,
# which is what encodes the super modifier). The matching bindings live in
# ~/.config/herdr/config.toml. Cost: outside Herdr these chords do nothing, so
# Cmd+Shift+W is the remaining way to close a Ghostty window and Cmd+G no
# longer repeats a Ghostty search.
keybind = super+d=unbind
keybind = super+shift+d=unbind
keybind = super+t=unbind
keybind = super+w=unbind
keybind = super+k=unbind
keybind = super+g=unbind
keybind = super+shift+enter=unbind

# Both spellings: Ghostty binds super+N and super+digit_N to goto_tab.
keybind = super+1=unbind
keybind = super+digit_1=unbind
keybind = super+2=unbind
keybind = super+digit_2=unbind
keybind = super+3=unbind
keybind = super+digit_3=unbind
keybind = super+4=unbind
keybind = super+digit_4=unbind
keybind = super+5=unbind
keybind = super+digit_5=unbind
keybind = super+6=unbind
keybind = super+digit_6=unbind
keybind = super+7=unbind
keybind = super+digit_7=unbind
keybind = super+8=unbind
keybind = super+digit_8=unbind
keybind = super+9=unbind
keybind = super+digit_9=unbind

# goto_split / resize_split — Herdr moves and resizes panes with these instead.
keybind = super+alt+arrow_left=unbind
keybind = super+alt+arrow_right=unbind
keybind = super+alt+arrow_up=unbind
keybind = super+alt+arrow_down=unbind
keybind = super+ctrl+arrow_left=unbind
keybind = super+ctrl+arrow_right=unbind
keybind = super+ctrl+arrow_up=unbind
keybind = super+ctrl+arrow_down=unbind

# jump_to_prompt — Herdr walks between spaces with these instead.
keybind = super+shift+arrow_up=unbind
keybind = super+shift+arrow_down=unbind
