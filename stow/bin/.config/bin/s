#!/bin/bash

selected=$(zoxide query --list | sed "s|$HOME|~|g" | fzf | sed "s|~|$HOME|g")

if [ -z "$selected" ]; then
    exit 0
fi

to_title() {
    echo "$1" | sed 's/-/ /g' | awk '{for(i=1;i<=NF;i++) $i=toupper(substr($i,1,1)) substr($i,2)}1'
}

name=$(to_title "$(basename "$selected")")

# Fresh workspaces get a vertical split, with the right column split again
# horizontally: left stays full height, right becomes top/bottom. --no-focus
# throughout so the cursor stays in the left pane.
herdr_default_panes() {
    local root=$1 right
    right=$(herdr pane split "$root" --direction right --cwd "$selected" --no-focus 2>/dev/null |
        jq -r '.result.pane.pane_id // empty' 2>/dev/null)
    [ -z "$right" ] && return
    herdr pane split "$right" --direction down --cwd "$selected" --no-focus >/dev/null 2>&1
}

open_herdr() {
    # herdr panes report a real cwd, so match on that instead of walking the
    # path: take the deepest workspace whose cwd is $selected or an ancestor.
    local panes match ws cwd pane root
    panes=$(herdr pane list 2>/dev/null)
    match=$(echo "$panes" | jq -r --arg p "$selected" '
        [.result.panes[] | select(.cwd != null and (.cwd as $c | $p == $c or ($p | startswith($c + "/"))))]
        | sort_by(.cwd | length) | last
        | if . == null then empty else "\(.workspace_id)\t\(.cwd)" end' 2>/dev/null)

    if [ -z "$match" ]; then
        # --label at create time, so no follow-up rename is needed
        root=$(herdr workspace create --cwd "$selected" --label "$name" --focus 2>/dev/null |
            jq -r '.result.root_pane.pane_id // empty' 2>/dev/null)
        [ -n "$root" ] && herdr_default_panes "$root"
        return
    fi

    ws=${match%%$'\t'*}
    cwd=${match#*$'\t'}
    herdr workspace focus "$ws" >/dev/null 2>&1
    [ "$cwd" = "$selected" ] && return

    # Selected path is a child of the matched workspace, so cd into it — but
    # only in a pane with no agent attached, never into a running Claude/agent.
    pane=$(echo "$panes" | jq -r --arg ws "$ws" '
        [.result.panes[] | select(.workspace_id == $ws and (has("agent") | not))]
        | (map(select(.focused)) + .) | first | .pane_id // empty' 2>/dev/null)
    if [ -n "$pane" ]; then
        herdr pane run "$pane" "cd $(printf '%q' "$selected") && clear" >/dev/null 2>&1
    fi
}

open_cmux() {
    local workspaces path existing segment title suffix ref
    workspaces=$(cmux list-workspaces 2>/dev/null)

    # Walk up the path to find a matching workspace (by name or path)
    path="$selected"
    existing=""
    while [ "$path" != "/" ] && [ "$path" != "$HOME" ]; do
        segment=$(basename "$path")
        title=$(to_title "$segment")
        suffix="${path#$HOME}"

        existing=$(echo "$workspaces" | grep -E "($suffix|  $title( |$))" | head -1 | grep -o 'workspace:[0-9]*')
        if [ -n "$existing" ]; then
            break
        fi
        path=$(dirname "$path")
    done

    if [ -n "$existing" ]; then
        cmux select-workspace --workspace "$existing" >/dev/null 2>&1
        # If selected path is a child of the matched workspace, cd into it
        if [ "$path" != "$selected" ]; then
            cmux send --workspace "$existing" "cd $selected && clear\n" >/dev/null 2>&1
        fi
    else
        ref=$(cmux new-workspace --cwd "$selected" 2>/dev/null | awk '{print $2}')
        if [ -n "$ref" ]; then
            cmux select-workspace --workspace "$ref" >/dev/null 2>&1
            cmux workspace-action rename --workspace "$ref" --title "$name" >/dev/null 2>&1
        fi
    fi
}

# Whichever multiplexer we're sitting in wins; outside both, fall back to cmux.
if [ -n "$HERDR_PANE_ID" ]; then
    open_herdr
else
    open_cmux
fi
