
node_modules
.DS_Store
k9s.log
stow/k9s/Library/Application Support/k9s/clusters
stow/agents/.agents/skills/
# Claude: only track the keep-list below; everything else in ~/.claude is
# runtime data (sessions, caches, history, plugins, projects, ...) and is
# ignored. Add a new file + its `!` negation here to start tracking it.
stow/claude/.claude/*
!stow/claude/.claude/CLAUDE.md
!stow/claude/.claude/settings.json
!stow/claude/.claude/statusline-command.sh
!stow/claude/.claude/skills/
!stow/claude/.claude/hooks/
